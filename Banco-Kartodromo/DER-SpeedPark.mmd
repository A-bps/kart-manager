erDiagram
  Cep {
    char_8 numero PK
    int cidade_codigo FK
  }
  Cidade {
    int codigo PK
    varchar_100 nome
    char_2 uf_sigla FK
  }
  Cliente {
    int pessoa_codigo PK,FK
    date data_nascimento
    int altura
    decimal_5_1 peso
  }
  Cliente_Corrida {
    int cliente_codigo PK,FK
    int corrida_nr PK,FK
    time melhor_volta
    varchar_100 penalidade
    time tempo
    int posicao
  }
  Corrida {
    int nr PK
    money preco
    date data
    time horario
    int pista_nr FK
    int funcionario_codigo FK
  }
  Corrida_Kart {
    int corrida_nr PK,FK
    int kart_codigo PK,FK
  }
  Dependente {
    int id PK
    int responsavel_codigo FK
    varchar_100 nome
    date nascimento
    varchar_20 categoria
    int altura
    decimal_5_1 peso
  }
  Faturamento {
    int id PK
    date data
    decimal_19_2 valor
    varchar_200 descricao
    varchar_30 forma_pagamento
    varchar_20 status
  }
  Funcionario {
    int pessoa_codigo PK,FK
    money salario
  }
  Gerente {
    int pessoa_codigo PK,FK
    money salario_extra
  }
  Kart {
    int codigo PK
    int numero UK
    varchar_50 estado
    varchar_255 historico
  }
  Manutencao {
    int codigo PK
    varchar_50 status
    money valor
    varchar_50 forma_pagamento
    int kart_codigo FK
  }
  Pagamento {
    int codigo PK
    money valor
    varchar_50 status
    varchar_50 forma_pagamento
    int cliente_codigo FK
    int corrida_nr FK
  }
  Pessoa {
    int codigo PK
    varchar_100 nome
    char_11 cpf UK
    varchar_100 email UK
    varchar_20 fone
    char_8 cep_numero FK
    varchar_100 senha_hash
    varchar_20 perfil
    datetime2 criado_em
  }
  Pista {
    int nr PK
    varchar_100 nome
    varchar_20 codigo UK
    int capacidade
    int metros
    decimal_10_2 preco_por_min
    decimal_10_2 preco_por_volta
    varchar_20 categoria
  }
  Prova {
    int id PK
    int numero
    int pista_nr FK
    int duracao_seg
    datetime2 iniciada_em
    datetime2 encerrada_em
    varchar_10 status
  }
  Reserva {
    int id PK
    int cliente_codigo FK
    varchar_100 participante
    int pista_nr FK
    date data
    time horario
    varchar_10 formato
    int qtd
    varchar_30 forma_pagamento
    decimal_19_2 valor
    datetime2 criada_em
  }
  Resultado {
    int id PK
    int prova_id FK
    int posicao
    varchar_10 kart
    varchar_100 piloto_nome
    varchar_20 melhor_volta
    varchar_100 penalidades
  }
  Uf {
    char_2 sigla PK
    varchar_50 nome
  }
  Cidade ||--o{ Cep : "cidade_codigo"
